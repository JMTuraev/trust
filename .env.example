# Server
PORT=3000

# Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=https://cgqudcbvezwxjxgaqdiw.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Ilova sessiya tokenlari uchun maxfiy kalit (kuchli tasodifiy qiymat)
# Yaratish: openssl rand -hex 32
APP_JWT_SECRET=your_random_secret

# DevSMS (devsms.uz -> Dashboard -> API token)
DEVSMS_TOKEN=your_devsms_token
# Eskiz universal OTP shablonidagi servis nomi
SMS_SERVICE_NAME=AllClubs
# 1=Amaliyot tasdiqlash, 2=Parol tiklash, 3=Ro'yxatdan o'tish, 4=Tizimga kirish
SMS_TEMPLATE_TYPE=4

# OTP sozlamalari
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# LLM parsing (matn -> daromad/xarajat/qarz), XOTIRA-ovoz-va-kategoriya.md §3-§4 bo'yicha.
# 2026-08-03 PO qarori: ASOSIY provayder — Anthropic Claude (to'langan Console hisobi).
# Zanjir: Anthropic -> Groq -> OpenAI -> qoida-parser.
# Kalit Trust AI chat (docs/ai-character.md) bilan BITTA — console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Parsing modeli (ixtiyoriy; default kodda: claude-haiku-4-5 — eng arzon+tez joriy avlod)
ANTHROPIC_MODEL=
# Token tejash: per-user kunlik Anthropic chaqiruv limiti (oshsa — lug'at/qoida yo'li)
ANTHROPIC_USER_DAILY_MAX=40
# Butun servis bo'yicha kunlik token kill-switch (oshsa Anthropic o'tkaziladi, zaxira davom etadi)
ANTHROPIC_DAILY_TOKEN_MAX=300000
# Zaxira 1: Groq (console.groq.com -> API Keys; bepul kvota 100k token/kun — tugasa keyingisi)
GROQ_API_KEY=
# Zaxira 2 (ixtiyoriy): OpenAI (gpt-4o-mini)
OPENAI_API_KEY=
